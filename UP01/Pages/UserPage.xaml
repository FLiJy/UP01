<Page x:Class="UP01.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Личный кабинет">

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBrush}"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Автосервис"
                               Foreground="{DynamicResource WhiteBrush}"
                               FontFamily="Open Sans"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="UserNameTextBlock"
                               Foreground="{DynamicResource WhiteBrush}"
                               FontFamily="Open Sans"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Button Content="Сменить пароль"
                            Width="135"
                            Click="ChangePasswordButton_Click"/>

                    <Button Content="Сменить тему"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="ThemeButton_Click"
                            ToolTip="Переключить светлую и тёмную тему"
                            Width="120"
                            Margin="10,0,0,0"/>

                    <Button Content="Выйти"
                            Width="80"
                            Click="LogoutButton_Click"
                            Background="{DynamicResource ErrorBrush}"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная часть -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">

                <TextBlock Text="Добро пожаловать!"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,5"/>

                

                <!-- Карточки статистики -->
                <UniformGrid Columns="3" Margin="0,0,0,20">

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Автомобили"
                                       FontSize="14"
                                       Opacity="0.8"/>
                            <TextBlock x:Name="VehiclesCountTextBlock"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="5,0"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Всего заказов"
                                       FontSize="14"
                                       Opacity="0.8"/>
                            <TextBlock x:Name="OrdersCountTextBlock"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="10,0,0,0"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Завершено заказов"
                                       FontSize="14"
                                       Opacity="0.8"/>
                            <TextBlock x:Name="CompletedOrdersCountTextBlock"
                                       Text="0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Поиск и сортировка -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="12"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Поиск по автомобилям или заказам"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <ComboBox x:Name="SortComboBox"
                                  Grid.Column="1"
                                  Margin="10,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem Content="По умолчанию"/>
                            <ComboBoxItem Content="По возрастанию"/>
                            <ComboBoxItem Content="По убыванию"/>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Content="Сбросить"
                                Click="ResetButton_Click"/>
                    </Grid>
                </Border>

                <!-- Данные автосервиса -->
                <TabControl x:Name="DataTabControl"
                            SelectionChanged="DataTabControl_SelectionChanged"
                            MinHeight="300">

                    <TabItem Header="Автомобили">
                        <DataGrid x:Name="VehiclesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  IsSynchronizedWithCurrentItem="False">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding vehicle_id}"
                                                    Width="60"/>
                                <DataGridTextColumn Header="Марка"
                                                    Binding="{Binding make}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Модель"
                                                    Binding="{Binding model}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Год"
                                                    Binding="{Binding year}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="Гос. номер"
                                                    Binding="{Binding license_plate}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="VIN"
                                                    Binding="{Binding vin}"
                                                    Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Заказы">
                        <DataGrid x:Name="OrdersDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  IsSynchronizedWithCurrentItem="False">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№ заказа"
                                                    Binding="{Binding order_id}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="ID автомобиля"
                                                    Binding="{Binding vehicle_id}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Статус"
                                                    Binding="{Binding status}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Дата начала"
                                                    Binding="{Binding start_date, StringFormat={}{0:dd.MM.yyyy}}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Дата завершения"
                                                    Binding="{Binding completion_date, StringFormat={}{0:dd.MM.yyyy}}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="Стоимость"
                                                    Binding="{Binding total_amount, StringFormat={}{0:N2} руб.}"
                                                    Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>

                <TextBlock Text="Представлена общая информация автосервиса."
                           FontSize="12"
                           Opacity="0.7"
                           Margin="0,12,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>