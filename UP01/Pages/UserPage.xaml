<Page x:Class="UP01.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage">
    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Верхняя панель -->

        <Border
            Grid.Row="0"
            Background="{DynamicResource SecondaryBrush}"
            Padding="20,10">

            <Grid>

                <TextBlock
                    Text="Автосервис"
                    Foreground="{DynamicResource WhiteBrush}"
                    FontFamily="Open Sans"
                    FontSize="22"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <TextBlock
                        x:Name="UserNameTextBlock"
                        Foreground="{DynamicResource WhiteBrush}"
                        FontFamily="Open Sans"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"/>

                    <Button
                        Content="Сменить пароль"
                        Width="150"
                        Click="ChangePasswordButton_Click"/>

                    <Button
                        Content="Выйти"
                        Width="100"
                        Click="LogoutButton_Click"
                        Background="{DynamicResource ErrorBrush}"
                        Margin="10,0,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- Основная часть -->

        <Grid
            Grid.Row="1"
            Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Заголовок -->

            <TextBlock
                Grid.Row="0"
                Text="Информация автосервиса"
                Style="{StaticResource PageTitleStyle}"
                Margin="0,0,0,15"/>


            <!-- Панель поиска -->

            <Border
                Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,15"
                Padding="10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>


                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        ToolTip="Введите текст для поиска"
                        TextChanged="SearchTextBox_TextChanged"/>


                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Column="1"
                        Margin="10,0"
                        SelectionChanged="SortComboBox_SelectionChanged">

                        <ComboBoxItem
                            Content="По умолчанию"/>

                        <ComboBoxItem
                            Content="По имени"/>

                        <ComboBoxItem
                            Content="По фамилии"/>

                    </ComboBox>


                    <Button
                        Grid.Column="2"
                        Content="Сбросить"
                        Click="ResetButton_Click"/>

                </Grid>

            </Border>


            <!-- Таблицы -->

            <TabControl
                Grid.Row="2"
                x:Name="DataTabControl"
                SelectionChanged="DataTabControl_SelectionChanged">





                <TabItem Header="Клиенты">

                    <DataGrid
                        x:Name="ClientsDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding client_id}"
                                Width="60"/>

                            <DataGridTextColumn
                                Header="Имя"
                                Binding="{Binding first_name}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Фамилия"
                                Binding="{Binding last_name}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Телефон"
                                Binding="{Binding phone}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="Email"
                                Binding="{Binding email}"
                                Width="200"/>

                            <DataGridTextColumn
                                Header="Дата регистрации"
                                Binding="{Binding created_at}"
                                Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </TabItem>


                <!-- АВТОМОБИЛИ -->

                <TabItem Header="Автомобили">

                    <DataGrid
                        x:Name="VehiclesDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding vehicle_id}"
                                Width="60"/>

                            <DataGridTextColumn
                                Header="ID клиента"
                                Binding="{Binding client_id}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="VIN"
                                Binding="{Binding vin}"
                                Width="180"/>

                            <DataGridTextColumn
                                Header="Марка"
                                Binding="{Binding make}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Модель"
                                Binding="{Binding model}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Год"
                                Binding="{Binding year}"
                                Width="80"/>

                            <DataGridTextColumn
                                Header="Гос. номер"
                                Binding="{Binding license_plate}"
                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </TabItem>


                <!-- ЗАКАЗЫ -->

                <TabItem Header="Заказы">

                    <DataGrid
                        x:Name="OrdersDataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding order_id}"
                                Width="60"/>

                            <DataGridTextColumn
                                Header="Автомобиль"
                                Binding="{Binding vehicle_id}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Сотрудник"
                                Binding="{Binding employee_id}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Статус"
                                Binding="{Binding status}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="Дата начала"
                                Binding="{Binding start_date}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="Дата завершения"
                                Binding="{Binding completion_date}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="Сумма"
                                Binding="{Binding total_amount}"
                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>

</Page>
