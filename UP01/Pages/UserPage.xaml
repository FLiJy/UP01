<Page x:Class="UP01.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage">
    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Верхняя панель -->

        <Border
            Grid.Row="0"
            Background="{DynamicResource SecondaryBrush}"
            Padding="20,10">

            <Grid>

                <TextBlock
                    Text="Автосервис"
                    Foreground="{DynamicResource WhiteBrush}"
                    FontFamily="Open Sans"
                    FontSize="22"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <TextBlock
                        x:Name="UserNameTextBlock"
                        Foreground="{DynamicResource WhiteBrush}"
                        FontFamily="Open Sans"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"/>

                    <Button
                        Content="Сменить пароль"
                        Width="150"
                        Click="ChangePasswordButton_Click"/>

                    <Button
                        Content="Выйти"
                        Width="100"
                        Click="LogoutButton_Click"
                        Background="{DynamicResource ErrorBrush}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- Основное содержимое -->

        <Grid
            Grid.Row="1"
            Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Заголовок -->

            <TextBlock
                Grid.Row="0"
                Text="Клиенты"
                Style="{StaticResource PageTitleStyle}"/>


            <!-- Поиск и фильтр -->

            <Border
                Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        ToolTip="Поиск по имени, фамилии или телефону"
                        TextChanged="SearchTextBox_TextChanged"/>

                    <ComboBox
                        x:Name="SortComboBox"
                        Grid.Column="1"
                        Margin="10,5,10,5"
                        SelectionChanged="SortComboBox_SelectionChanged">

                        <ComboBoxItem
                            Content="По фамилии"/>

                        <ComboBoxItem
                            Content="По имени"/>

                        <ComboBoxItem
                            Content="По телефону"/>

                    </ComboBox>

                    <Button
                        Grid.Column="2"
                        Content="Сбросить"
                        Click="ResetButton_Click"/>

                </Grid>

            </Border>


            <!-- Таблица -->

            <DataGrid
                x:Name="ClientsDataGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionChanged="ClientsDataGrid_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding client_id}"
                        Width="60"/>

                    <DataGridTextColumn
                        Header="Имя"
                        Binding="{Binding first_name}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Фамилия"
                        Binding="{Binding last_name}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Телефон"
                        Binding="{Binding phone}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Email"
                        Binding="{Binding email}"
                        Width="200"/>

                    <DataGridTextColumn
                        Header="Дата регистрации"
                        Binding="{Binding created_at}"
                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Page>
