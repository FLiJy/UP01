<Page x:Class="UP01.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Border
            Width="450"
            Padding="40"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <Image
                    Source="/res/Логотип.png"
                    Width="150"
                    Height="100"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="Регистрация"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalAlignment="Center"/>

                <TextBlock Text="Имя"/>
                <TextBox
                    x:Name="FirstNameTextBox"
                    ToolTip="Введите имя"
                    MaxLength="100"/>

                <TextBlock
                    Text="Фамилия"
                    Margin="0,5,0,0"/>

                <TextBox
                    x:Name="LastNameTextBox"
                    ToolTip="Введите фамилию"
                    MaxLength="100"/>

                <TextBlock
                    Text="Логин"
                    Margin="0,5,0,0"/>

                <TextBox
                    x:Name="LoginTextBox"
                    ToolTip="Введите логин"
                    MaxLength="50"/>

                <TextBlock
                    Text="Пароль"
                    Margin="0,5,0,0"/>

                <PasswordBox
                    x:Name="PasswordBox"
                    ToolTip="Введите пароль"
                    MaxLength="50"/>

                <TextBlock
                    Text="Повтор пароля"
                    Margin="0,5,0,0"/>

                <PasswordBox
                    x:Name="RepeatPasswordBox"
                    ToolTip="Повторно введите пароль"
                    MaxLength="50"/>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="{DynamicResource ErrorTextBrush}"
                    FontFamily="Open Sans"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0"/>

                <Button
                    Content="Зарегистрироваться"
                    Click="RegisterButton_Click"
                    Margin="0,15,0,5"/>

                <Button
                    Content="Вернуться к авторизации"
                    Click="BackButton_Click"
                    Background="{DynamicResource SecondaryBrush}"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>