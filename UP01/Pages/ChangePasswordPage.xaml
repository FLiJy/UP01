<Page x:Class="UP01.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePasswordPage">
    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Border
            Width="450"
            Padding="40"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <TextBlock
                    Text="Смена пароля"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Введите старый и новый пароль"
                    Style="{StaticResource SubtitleStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,25"/>


                <TextBlock
                    Text="Старый пароль"/>

                <PasswordBox
                    x:Name="OldPasswordBox"
                    ToolTip="Введите текущий пароль"
                    MaxLength="50"/>


                <TextBlock
                    Text="Новый пароль"
                    Margin="0,10,0,0"/>

                <PasswordBox
                    x:Name="NewPasswordBox"
                    ToolTip="Введите новый пароль"
                    MaxLength="50"/>


                <TextBlock
                    Text="Повтор нового пароля"
                    Margin="0,10,0,0"/>

                <PasswordBox
                    x:Name="RepeatPasswordBox"
                    ToolTip="Повторно введите новый пароль"
                    MaxLength="50"/>


                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="{DynamicResource ErrorTextBrush}"
                    FontFamily="Open Sans"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0"/>


                <Button
                    Content="Сохранить"
                    Click="SaveButton_Click"
                    Margin="0,20,0,5"/>


                <Button
                    Content="Назад"
                    Click="BackButton_Click"
                    Background="{DynamicResource SecondaryBrush}"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>