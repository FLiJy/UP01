<Page x:Class="UP01.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Border
            Width="450"
            Padding="40"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- Логотип -->

                <Image
                    Source="/res/Логотип.png"
                    Width="180"
                    Height="140"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"/>


                <!-- Заголовок -->

                <TextBlock
                    Text="Авторизация"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalAlignment="Center"/>


                <TextBlock
                    Text="Войдите в систему автосервиса"
                    Style="{StaticResource SubtitleStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,20"/>


                <!-- Логин -->

                <TextBlock
                    Text="Логин"
                    Margin="0,5,0,0"/>

                <TextBox
                    x:Name="LoginTextBox"
                    ToolTip="Введите логин"
                    MaxLength="50"/>


                <!-- Пароль -->

                <TextBlock
                    Text="Пароль"
                    Margin="0,10,0,0"/>

                <PasswordBox
                    x:Name="PasswordBox"
                    ToolTip="Введите пароль"
                    MaxLength="50"/>


                <!-- Сообщение -->

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Text=""
                    Foreground="{DynamicResource ErrorTextBrush}"
                    FontFamily="Open Sans"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0"/>


                <!-- Вход -->

                <Button
                    Content="Войти"
                    Click="LoginButton_Click"
                    Margin="0,20,0,5"/>


                <!-- Регистрация -->

                <Button
                    Content="Регистрация"
                    Click="RegisterButton_Click"
                    Background="{DynamicResource SecondaryBrush}"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>
