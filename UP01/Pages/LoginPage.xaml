<Page x:Class="UP01.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Border
            Width="450"
            Padding="40"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- Логотип -->
                <Image
                    Source="/res/Логотип.png"
                    Width="180"
                    Height="130"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>


                <!-- Заголовок -->
                <TextBlock
                    Text="Авторизация"
                    Style="{StaticResource PageTitleStyle}"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Система управления автосервисом"
                    Style="{StaticResource SubtitleStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,20"/>


                <!-- Логин -->
                <TextBlock
                    Text="Логин"/>

                <TextBox
                    x:Name="LoginTextBox"
                    ToolTip="Введите логин"
                    MaxLength="50"/>


                <!-- Пароль -->
                <TextBlock
                    Text="Пароль"
                    Margin="0,10,0,0"/>

                <PasswordBox
                    x:Name="PasswordBox"
                    ToolTip="Введите пароль"
                    MaxLength="50"/>


                <!-- Капча -->
                <StackPanel
                    x:Name="CaptchaPanel"
                    Visibility="Collapsed"
                    Margin="0,10,0,0">

                    <TextBlock
                        Text="Введите код с изображения:"
                        Margin="0,0,0,5"/>

                    <Border
                        Background="{DynamicResource LightGrayBrush}"
                        CornerRadius="5"
                        Padding="10"
                        HorizontalAlignment="Left">

                        <TextBlock
                            x:Name="CaptchaTextBlock"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            />
                    </Border>

                    <TextBox
                        x:Name="CaptchaTextBox"
                        ToolTip="Введите код с изображения"
                        MaxLength="5"/>

                </StackPanel>


                <!-- Сообщение об ошибке -->
                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="{DynamicResource ErrorTextBrush}"
                    FontFamily="Open Sans"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0"/>


                <!-- Кнопка входа -->
                <Button
                    Content="Войти"
                    Click="LoginButton_Click"
                    Margin="0,20,0,5"/>


                <!-- Регистрация -->
                <Button
                    Content="Регистрация"
                    Click="RegisterButton_Click"
                    Background="{DynamicResource SecondaryBrush}"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>