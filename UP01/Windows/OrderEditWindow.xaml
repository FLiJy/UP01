<Window x:Class="UP01.Windows.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01.Windows"
        mc:Ignorable="d"
        Title="Заказ"
        Width="500"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">

    <Border Margin="20"
            Padding="25"
            CornerRadius="10"
            Background="{DynamicResource CardBackgroundBrush}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       Text="Добавление заказа"
                       Style="{StaticResource PageTitleStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>


            <!-- Автомобиль -->

            <StackPanel Grid.Row="1"
                        Margin="0,5">

                <TextBlock Text="Автомобиль"/>

                <ComboBox x:Name="VehicleComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="vehicle_id"
                          ToolTip="Выберите автомобиль"/>

            </StackPanel>


            <!-- Статус -->

            <StackPanel Grid.Row="2"
                        Margin="0,5">

                <TextBlock Text="Статус"/>

                <ComboBox x:Name="StatusComboBox"
                          ToolTip="Выберите статус">

                    <ComboBoxItem Content="Новый"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Завершён"/>
                    <ComboBoxItem Content="Отменён"/>

                </ComboBox>

            </StackPanel>


            <!-- Дата начала -->

            <StackPanel Grid.Row="3"
                        Margin="0,5">

                <TextBlock Text="Дата начала"/>

                <DatePicker x:Name="StartDatePicker"/>

            </StackPanel>


            <!-- Дата завершения -->

            <StackPanel Grid.Row="4"
                        Margin="0,5">

                <TextBlock Text="Дата завершения"/>

                <DatePicker x:Name="CompletionDatePicker"/>

            </StackPanel>


            <!-- Сумма -->

            <StackPanel Grid.Row="5"
                        Margin="0,5">

                <TextBlock Text="Сумма заказа"/>

                <TextBox x:Name="TotalAmountTextBox"
                         ToolTip="Введите сумму заказа"/>

            </StackPanel>


            <TextBlock x:Name="ErrorTextBlock"
                       Grid.Row="6"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10"/>


            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Сохранить"
                        Click="SaveButton_Click"
                        Margin="5"/>

                <Button Content="Отмена"
                        Click="CancelButton_Click"
                        Margin="5"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>