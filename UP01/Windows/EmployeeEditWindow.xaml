<Window x:Class="UP01.Windows.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="430"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WindowTitle"
                   Text="Добавление сотрудника"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Имя"/>
            <TextBox x:Name="FirstNameTextBox"
                     Height="30"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Фамилия"/>
            <TextBox x:Name="LastNameTextBox"
                     Height="30"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneTextBox"
                     Height="30"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Должность"/>
            <TextBox x:Name="PositionTextBox"
                     Height="30"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Дата приёма на работу"/>
            <DatePicker x:Name="HireDatePicker"
                        Height="30"
                        Margin="0,5,0,12"/>

            <CheckBox x:Name="IsActiveCheckBox"
                      Content="Сотрудник работает"
                      IsChecked="True"
                      Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Сохранить"
                    Width="110"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="35"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>