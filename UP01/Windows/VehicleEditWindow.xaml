<Window x:Class="UP01.Windows.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01.Windows"
        mc:Ignorable="d"
        Title="Автомобиль"
        Width="550"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackgroundBrush}">

    <Border
        Margin="20"
        Padding="25"
        Background="{DynamicResource CardBackgroundBrush}"
        CornerRadius="15">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Заголовок -->

            <TextBlock
                x:Name="TitleTextBlock"
                Grid.Row="0"
                Text="Добавление автомобиля"
                Style="{StaticResource PageTitleStyle}"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"/>


            <!-- Владелец -->

            <StackPanel Grid.Row="1">

                <TextBlock Text="Владелец"/>

                <ComboBox
                    x:Name="ClientComboBox"
                    DisplayMemberPath="FullName"
                    SelectedValuePath="client_id"
                    ToolTip="Выберите клиента"/>

            </StackPanel>


            <!-- VIN -->

            <StackPanel
                Grid.Row="2"
                Margin="0,12,0,0">

                <TextBlock Text="VIN"/>

                <TextBox
                    x:Name="VinTextBox"
                    MaxLength="17"
                    ToolTip="VIN должен содержать 17 символов"
                    CharacterCasing="Upper"
                    PreviewTextInput="VinTextBox_PreviewTextInput"/>

            </StackPanel>


            <!-- Марка -->

            <StackPanel
                Grid.Row="3"
                Margin="0,12,0,0">

                <TextBlock Text="Марка"/>

                <TextBox
                    x:Name="MakeTextBox"
                    MaxLength="50"
                    ToolTip="Например: Toyota"/>

            </StackPanel>


            <!-- Модель -->

            <StackPanel
                Grid.Row="4"
                Margin="0,12,0,0">

                <TextBlock Text="Модель"/>

                <TextBox
                    x:Name="ModelTextBox"
                    MaxLength="50"
                    ToolTip="Например: Camry"/>

            </StackPanel>


            <!-- Год -->

            <StackPanel
                Grid.Row="5"
                Margin="0,12,0,0">

                <TextBlock Text="Год выпуска"/>

                <TextBox
                    x:Name="YearTextBox"
                    MaxLength="4"
                    ToolTip="Введите год от 1900 до текущего года"
                    PreviewTextInput="NumberOnly_PreviewTextInput"/>

            </StackPanel>


            <!-- Госномер -->

            <StackPanel
                Grid.Row="6"
                Margin="0,12,0,0">

                <TextBlock Text="Государственный номер"/>

                <TextBox
                    x:Name="LicensePlateTextBox"
                    MaxLength="9"
                    CharacterCasing="Upper"
                    ToolTip="Например: А123ВС777"/>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="{DynamicResource ErrorTextBrush}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"/>

            </StackPanel>


            <!-- Кнопки -->

            <StackPanel
                Grid.Row="7"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,20,0,0">

                <Button
                    Content="Сохранить"
                    Width="130"
                    Click="SaveButton_Click"/>

                <Button
                    Content="Отмена"
                    Width="130"
                    Margin="10,0,0,0"
                    Background="{DynamicResource SecondaryBrush}"
                    Click="CancelButton_Click"/>

            </StackPanel>

        </Grid>
    </Border>

</Window>